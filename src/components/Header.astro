---
import { SITE_TITLE, NAV, GITHUB_REPO } from "../consts";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

// Exact match only. A prefix test reads well until you are on
// /docs/tutorial, where it marks BOTH "Docs" and "Tutorial" as
// aria-current="page" -- two current pages, which is not a thing, and
// which assistive technology announces as such. The nav's section
// entries stay unmarked on their children; the sidebar is what shows
// where you are inside a section.
const isCurrent = (href: string) => path === href;
---

<header>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="bar">
    <a class="brand" href="/">
      <img src="/brand/ostracon-restored.png" width="30" height="39" alt="" />
      <span>
        <strong>{SITE_TITLE}</strong>
        <small>code generation, made repeatable</small>
      </span>
    </a>

    <nav aria-label="Primary">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a href={GITHUB_REPO} rel="noopener">GitHub</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    border-top: 4px solid var(--primary);
    border-bottom: 1px solid var(--rule-strong);
    background: var(--bg-raised);
    box-shadow: 0 3px 16px var(--shadow);
  }

  .bar {
    max-width: var(--page);
    margin: 0 auto;
    padding: 10px 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
  }

  .brand {
    text-decoration: none;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand strong {
    display: block;
    font-family: var(--font-head);
    font-size: 1.28rem;
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .brand img {
    border: 1px solid var(--rule-strong);
    box-shadow: 1px 2px 5px var(--shadow);
  }
  .brand small {
    display: block;
    margin-top: 3px;
    color: var(--ink-faint);
    font-size: 0.65rem;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  nav a {
    text-decoration: none;
    color: var(--ink-muted);
    font-size: 0.94rem;
  }
  nav a:hover {
    color: var(--primary);
  }
  nav a[aria-current="page"] {
    color: var(--primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  @media (max-width: 640px) {
    nav {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
