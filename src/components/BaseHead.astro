---
import "../styles/global.css";
import Analytics from "./Analytics.astro";
// The same function the Worker uses to find a page's markdown twin, so the
// link advertised here is the URL that actually answers.
import { markdownTwin } from "../worker";

interface Props {
  title: string;
  description: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description } = Astro.props;
const twin = markdownTwin(canonicalURL.pathname);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />

<meta property="twitter:card" content="summary" />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />

<!-- The markdown representation of this page, for anything that would rather
     read it than parse HTML. The same bytes are served from this URL under
     `Accept: text/markdown`. -->
{twin && <link rel="alternate" type="text/markdown" href={twin} />}

<Analytics />
