---
import Base from "./Base.astro";

// The layout for the site's authored prose pages -- /about, /legacy,
// /contact and /privacy. The documentation has its own layouts because it has
// a sidebar and a source link; these pages are one column of text and share
// nothing with it but the tokens.

interface Props {
  title: string;
  description: string;
  lede?: string;
}
const { title, description, lede } = Astro.props;
---

<Base title={title} description={description}>
  <article class="prose">
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </article>
</Base>

<style>
  .prose {
    max-width: var(--measure);
    padding: 40px 0 64px;
  }
  .lede {
    font-size: 1.1rem;
    color: var(--ink-muted);
  }
  .prose :global(h2) {
    margin-top: 44px;
  }
  .prose :global(dl) {
    margin: 20px 0 0;
  }
  .prose :global(dt) {
    font-weight: 600;
    margin-top: 18px;
  }
  .prose :global(dd) {
    margin: 4px 0 0;
    color: var(--ink-muted);
  }
  .prose :global(.footnote) {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    color: var(--ink-muted);
  }
</style>
